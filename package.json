{
  "name": "dsh-outpost",
  "license": "MIT",
  "version": "0.2.4",
  "private": true,
  "description": "前哨：盯住一个赛道里的产品，每天自动调研、核查，出一份今日哨报。DSH (DeepSeek Harness) 插件。",
  "keywords": [
    "dsh-plugin-market",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis-plugin",
    "ai-agent",
    "product-tracking",
    "competitive-intelligence",
    "news-monitoring",
    "daily-brief"
  ],
  "homepage": "https://github.com/TigerdyXu/AgentOutpost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TigerdyXu/AgentOutpost.git"
  },
  "bugs": {
    "url": "https://github.com/TigerdyXu/AgentOutpost/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "prompts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.3-alpha.2 <0.3.0"
  },
  "packageManager": "pnpm@11.28.5",
  "dependencies": {
    "diff": "9.0.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-web": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.3-alpha.2 <0.3.0",
    "@deepseek-ai/schemastery": "^3.20.0-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/cosmokit": "1.10.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-web": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
